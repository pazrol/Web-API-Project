    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login"
            },
            "description": "Use this single request for every role. Change login_email and login_password to any account. The response includes data.user.role; the test script detects it and saves current_role/current_user_id/current_email and the JWT token automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test(\"Login returns HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (body && body.success && body.data && body.data.token && body.data.user) {",
                  "  pm.collectionVariables.set(\"token\", body.data.token);",
                  "  pm.collectionVariables.set(\"current_role\", String(body.data.user.role || \"\"));",
                  "  pm.collectionVariables.set(\"current_user_id\", String(body.data.user.id || \"\"));",
                  "  pm.collectionVariables.set(\"current_email\", String(body.data.user.email || \"\"));",
                  "  console.log(\"Login successful. Detected role: \" + body.data.user.role + \". JWT saved to {{token}}.\");",
                  "} else {",
                  "  console.log(\"Login failed. Check email/password and API response.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register"
            },
            "description": "Creates an account through the registration endpoint. Default is customer. Set signup_role to customer, organiser, or admin. For Admin registration, set signup_reference_key to the fixed key configured in the backend; the server must validate it. Registration does not return a JWT, so run Login after successful registration.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Signup Test\",\n  \"email\": \"postman.signup.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"{{signup_role}}\",\n  \"reference_key\": \"{{signup_reference_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test(\"Register returns HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (body && body.success && body.data && body.data.id !== undefined) {",
                  "  pm.collectionVariables.set(\"registered_user_id\", String(body.data.id));",
                  "  pm.collectionVariables.set(\"registered_email\", String(body.data.email || \"\"));",
                  "  pm.collectionVariables.set(\"registered_role\", String(body.data.role || \"\"));",
                  "  console.log(\"Registration successful. Created role: \" + body.data.role + \". Run Login using this email to receive a JWT.\");",
                  "} else {",
                  "  console.log(\"Registration failed. Check required fields, duplicate email, role, reference key, and API response.\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
