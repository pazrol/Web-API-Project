            "url": {
              "raw": "{{base_url}}/bookings/{{qr_booking_id}}/qr"
            },
            "description": "Requires a valid Bearer JWT and X-API-Key header. Set {{api_key}} to the local backend key. qr_booking_id defaults to confirmed booking 1 from the provided sample data; external QR service used by this backend is QRServer."
          }
        }
      ]
